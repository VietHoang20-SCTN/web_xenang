# Copy file này thành server/.env; không commit file .env thật.
NODE_ENV=development

# MySQL / MariaDB
DATABASE_URL="mysql://user:password@localhost:3306/xenang"

# Tạo secret riêng tối thiểu 32 ký tự, ví dụ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-unique-password"

PORT=4000
# Chỉ bật khi origin nằm sau đúng một reverse proxy và không thể truy cập trực tiếp.
# TRUST_PROXY=1
# Domain được phép gọi API, phân tách bằng dấu phẩy; không dùng * với cookie.
CORS_ORIGINS="http://localhost:5173"

# Cloudinary: dùng URL hoặc bộ ba biến rời.
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="xenang"

# Build-time frontend: đặt trong client/.env nếu frontend gọi API khác origin.
# Cùng domain production hoặc dùng Vite proxy local thì không cần khai báo; mặc định là /api.
# VITE_API_URL="http://localhost:4000/api"